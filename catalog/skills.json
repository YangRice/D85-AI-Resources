    {
      "id": "toastmasters-poster-maker",
      "type": "journey",
      "version": "0.1.0",
      "resource_page": "make-a-toastmasters-poster",
      "requires": [
        "toastmasters-poster-reviewer"
      ],
      "recommends": [],
      "actions": [],
      "portable_references": [
        "brand-rules.{lang}.md",
        "production-contract.{lang}.md",
        "asset-guide.{lang}.md",
        "creative-quality.{lang}.md"
      ],
      "compatibility": {
        "en": "Text-only tools can prepare briefs and handoffs. New artwork requires image generation; image-to-editable-SVG reconstruction requires component decomposition, layout/compositing, rendering and image inspection; QR verification needs a decoder. Final approval requires a separate reviewer agent/session. State missing capabilities; never claim an unrendered or unverified poster is finished.",
        "zh": "纯文字工具可准备简报和交接；新画作需要图像生成；图片转可编辑 SVG 需要组件拆解、布局/合成、渲染和图片查看，二维码验证需要解码器。最终通过须独立评审代理/会话；缺能力须说明，不得称未渲染或未验证海报为完成。"
      }
    },
    {
      "id": "toastmasters-poster-reviewer",
      "type": "atomic",
      "version": "0.1.0",
      "resource_page": "review-a-toastmasters-poster",
      "requires": [],
      "recommends": [],
      "actions": [],
      "portable_references": [
        "brand-rules.{lang}.md",
        "production-contract.{lang}.md",
        "asset-guide.{lang}.md"
      ],
      "compatibility": {
        "en": "Text-only tools can provide preliminary findings. Full review requires inspecting the actual image, evidence for exact checks, and a decoder when QR codes are present. A separate agent/session is required for reviewing maker output. Report missing evidence and capabilities; never invent PASS or official approval.",
        "zh": "纯文字工具可提供初步发现。完整评审须查看实际图片、取得准确检查所需证据；有二维码时需要解码器。审核制作流程输出须独立代理/会话。缺证据或能力须说明，不得虚构PASS或官方批准。"
      }
    },
    {
      "id": "edit-svg-canvas",
      "type": "atomic",
      "version": "0.1.0",
      "resource_page": "edit-a-design-visually",
      "requires": [],
      "recommends": [],
      "actions": [],
      "portable_references": [
        "runtime.{lang}.md"
      ],
      "compatibility": {
        "en": "Use a suitable built-in canvas when available and chosen; its capabilities depend on the host. The Method Draw route requires the installed skill package, Python 3.10+, a local browser/server, and a verified cache or first-use network access. Text-only chats can prepare a manual handoff but cannot launch an editor.",
        "zh": "可用且用户选择时使用宿主内置画布，能力依宿主而定。Method Draw 路线需要完整技能包、Python 3.10+、本地浏览器及服务、已验证缓存或首次联网。纯文字聊天只能准备手动交接，不能启动编辑器。"
      }
    },
    {
      "id": "d85-skill-contributor",
      "type": "journey",
      "version": "0.1.0",
      "resource_page": "d85-skill-contributor",
      "requires": [],
      "recommends": [],
      "actions": [],
      "portable_references": [
        "contribution-rules.{lang}.md"
      ],
      "compatibility": {
        "en": "Text-only assistants can guide tests and prepare copyable contribution material. Inspecting local files and creating an actual GitHub PR require file access, Git/GitHub tools, network access, and the contributor's signed-in account. State unavailable checks and capabilities honestly; a handoff is not a submitted PR. This skill ends at submission; team review, merge, and website publication happen separately.",
        "zh": "纯文字助手可以引导测试并整理可复制的投稿材料。检查本地文件和实际创建 GitHub PR 需要文件访问、Git/GitHub 工具、网络及已登录的贡献者账号。缺少的检查或能力必须如实说明；准备材料不等于已提交 PR。本技能以投稿为终点，团队审核、合并和网站发布另行进行。"
      },
      "input_fields": {
        "en": [
          "My name:",
          "My Toastmasters club name:",
          "Local skill files or prompt text I can share:",
          "Who it helps and what it should accomplish:",
          "New skill or improvement to an existing one:",
          "Tests I have actually tried and their results:",
          "My AI platform and GitHub access, if known:",
          "Preferred response language:"
        ],
        "zh": [
          "我的姓名：",
          "我所属的头马俱乐部名称：",
          "我可以分享的本地技能文件或提示词：",
          "适用对象与希望完成的任务：",
          "新增技能或改进已有技能：",
          "我实际做过的测试与结果：",
          "我使用的 AI 平台与 GitHub 访问条件（如已知）：",
          "回复语言偏好："
        ]
      }
    },
